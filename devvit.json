{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "kiln-day",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true
    }
  },
  "menu": {
    "items": [
      {
        "label": "Light today's kiln",
        "description": "Post today's KILN so the community can load it",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-kiln": {
        "endpoint": "/internal/tasks/daily-kiln",
        "cron": "5 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}

{
  "private": true,
  "name": "kiln-day",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "KILN — one wood kiln a day, fired by the whole subreddit.",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run typecheck && npm run test && devvit upload",
    "dev": "devvit playtest",
    "login": "devvit login",

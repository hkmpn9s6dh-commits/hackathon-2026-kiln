{
  "private": true,
  "name": "daily-kiln",
  "version": "1.0.0",
  "description": "KILN — one pot, one firing, one shared kiln, every day. Reddit's Game of the Day Hackathon entry.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "devvit playtest",
    "preview": "npm run build && node scripts/preview.mjs",
    "login": "devvit login",
    "deploy": "npm run check && devvit upload",
    "check": "npm run test:types && npm run lint && npm run test",
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning \"src/**/*.test.ts\"",
    "test:types": "tsc --build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" scripts/*.mjs",
    "verify": "bash scripts/verify.sh"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/analytics": "0.15.3",
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.3",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "playwright-core": "^1.58.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7"
  }
}

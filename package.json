    "typecheck": "tsc --build",
    "test": "vitest run",
    "preflight": "node scripts/preflight.mjs",
    "dev:web": "node scripts/dev-server.mjs",
    "e2e": "node scripts/e2e.mjs",
    "verify": "bash scripts/verify.sh"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.3",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright-core": "^1.56.1",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "^3.2.4"
  }
